{
  "cSpell.words": [
    "genis",
    "rosids",
    "bruteforce",
    "nmap",
    "multiclass",
    "subflood"
  ],
  "jupyter.notebookFileRoot": "${workspaceFolder}",
  "python.envFile": "${workspaceFolder}/.env",
  "search.exclude": {
    "**/*.code-search": true,
    "**/bower_components": true,
    "**/node_modules": true,
    "/_artifacts/**/*": true
  },
  "workbench.editorAssociations": {
    "*.copilotmd": "vscode.markdown.preview.editor",
    "file:/**/*.csv": "jupyter-data-wrangler"
  }
}
